{
  "name": "ai-board",
  "version": "0.1.0",
  "description": "Dashboard quản lý agent, account và chat session (Claude Code, Codex)",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:dir": "electron-vite build && electron-builder --win dir --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "5.5",
    "dompurify": "^3.4.17",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.8",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@lydell/node-pty": "^1.1.0",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.11"
  },
  "author": "tamho",
  "build": {
    "appId": "local.tamho.ai-board",
    "productName": "AI Board",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Board",
      "artifactName": "AI-Board-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "TamHoChi3008",
      "repo": "ai_dashboard",
      "releaseType": "release"
    },
    "electronLanguages": [
      "en-US",
      "vi"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TamHoChi3008/ai_dashboard.git"
  }
}
